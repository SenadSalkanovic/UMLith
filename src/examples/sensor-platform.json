{
  "schemaVersion": 2,
  "nodes": [
    {
      "id": "platform",
      "kind": "system",
      "name": "Sensor Platform"
    },
    {
      "id": "sensors",
      "kind": "module",
      "name": "Sensors",
      "parentId": "platform",
      "moduleRole": "service"
    },
    {
      "id": "database",
      "kind": "module",
      "name": "Database",
      "parentId": "platform",
      "moduleRole": "database"
    },
    {
      "id": "Manufacturer",
      "kind": "class",
      "name": "Manufacturer",
      "parentId": "sensors"
    },
    {
      "id": "Hub",
      "kind": "class",
      "name": "Hub",
      "parentId": "sensors"
    },
    {
      "id": "Sensor",
      "kind": "class",
      "name": "Sensor",
      "parentId": "sensors",
      "isAbstract": true,
      "fields": [
        {
          "name": "serialNumber",
          "type": "String",
          "visibility": "private",
          "isStatic": false
        }
      ]
    },
    {
      "id": "Thermometer",
      "kind": "class",
      "name": "Thermometer",
      "parentId": "sensors"
    },
    {
      "id": "InfraredThermometer",
      "kind": "class",
      "name": "InfraredThermometer",
      "parentId": "sensors"
    },
    {
      "id": "TemperatureUnit",
      "kind": "enum",
      "name": "TemperatureUnit",
      "parentId": "sensors"
    },
    {
      "id": "Measurement",
      "kind": "class",
      "name": "Measurement",
      "parentId": "sensors",
      "fields": [
        {
          "name": "value",
          "type": "number",
          "visibility": "public"
        }
      ]
    },
    {
      "id": "DateTime",
      "kind": "class",
      "name": "DateTime",
      "parentId": "sensors"
    },
    {
      "id": "Hub.addSensor",
      "kind": "function",
      "name": "addSensor",
      "parentId": "Hub",
      "visibility": "public",
      "isStatic": false,
      "isAbstract": false,
      "description": "Add a sensor to the hub.",
      "signature": {
        "parameters": [
          {
            "name": "sensor",
            "type": "Sensor"
          }
        ],
        "returnType": "void"
      }
    },
    {
      "id": "Sensor.getMeasurement",
      "kind": "function",
      "name": "getMeasurement",
      "parentId": "Sensor",
      "visibility": "public",
      "isStatic": false,
      "isAbstract": true,
      "description": "Read the current measurement.",
      "signature": {
        "parameters": [],
        "returnType": "Measurement"
      }
    },
    {
      "id": "Sensor.getMeasurement.unit",
      "kind": "function",
      "name": "getMeasurement",
      "parentId": "Sensor",
      "visibility": "protected",
      "isStatic": false,
      "isAbstract": false,
      "description": "Read a converted measurement.",
      "signature": {
        "parameters": [
          {
            "name": "unit",
            "type": "TemperatureUnit"
          }
        ],
        "returnType": "Measurement"
      }
    },
    {
      "id": "Manufacturer.toString",
      "kind": "function",
      "name": "toString",
      "parentId": "Manufacturer",
      "visibility": "public",
      "isStatic": false,
      "isAbstract": false,
      "description": "Return the manufacturer display name.",
      "signature": {
        "parameters": [],
        "returnType": "String"
      }
    },
    {
      "id": "DateTime.isValid",
      "kind": "function",
      "name": "isValid",
      "parentId": "DateTime",
      "visibility": "public",
      "isStatic": true,
      "isAbstract": false,
      "description": "Check whether a date is valid.",
      "signature": {
        "parameters": [
          {
            "name": "value",
            "type": "DateTime"
          }
        ],
        "returnType": "boolean"
      }
    },
    {
      "id": "SensorRecord",
      "kind": "entity",
      "name": "SensorRecord",
      "parentId": "database",
      "mappedName": "sensors",
      "fields": [
        {
          "name": "id",
          "type": "Int",
          "key": "PK"
        },
        {
          "name": "serialNumber",
          "type": "String",
          "key": "UNIQUE"
        }
      ],
      "indexes": [
        {
          "fields": [
            "serialNumber"
          ],
          "type": "INDEX"
        }
      ]
    },
    {
      "id": "MeasurementRecord",
      "kind": "entity",
      "name": "MeasurementRecord",
      "parentId": "database",
      "mappedName": "measurements",
      "fields": [
        {
          "name": "id",
          "type": "Int",
          "key": "PK"
        },
        {
          "name": "sensorId",
          "type": "Int",
          "key": "FK",
          "optional": false
        },
        {
          "name": "value",
          "type": "Float"
        }
      ],
      "indexes": [
        {
          "fields": [
            "sensorId"
          ],
          "type": "INDEX"
        }
      ]
    },
    {
      "id": "range",
      "kind": "step",
      "name": "In supported range?",
      "stepType": "condition",
      "parentId": "Sensor.getMeasurement"
    },
    {
      "id": "result",
      "kind": "step",
      "name": "Return measurement",
      "stepType": "return",
      "parentId": "Sensor.getMeasurement"
    },
    {
      "id": "error",
      "kind": "step",
      "name": "Throw range error",
      "stepType": "throw",
      "parentId": "Sensor.getMeasurement"
    }
  ],
  "edges": [
    {
      "id": "thermometer-sensor",
      "source": "Thermometer",
      "target": "Sensor",
      "kind": "inherits"
    },
    {
      "id": "infrared-thermometer",
      "source": "InfraredThermometer",
      "target": "Thermometer",
      "kind": "inherits"
    },
    {
      "id": "hub-sensor",
      "source": "Hub",
      "target": "Sensor",
      "kind": "composes",
      "sourceEndpoint": {
        "role": "hub",
        "multiplicity": "1"
      },
      "targetEndpoint": {
        "role": "sensors",
        "multiplicity": "0..*"
      }
    },
    {
      "id": "sensor-manufacturer",
      "source": "Sensor",
      "target": "Manufacturer",
      "kind": "associates-with"
    },
    {
      "id": "thermometer-unit",
      "source": "Thermometer",
      "target": "TemperatureUnit",
      "kind": "associates-with",
      "targetEndpoint": {
        "role": "unit",
        "multiplicity": "1",
        "navigable": true
      }
    },
    {
      "id": "measurement-time",
      "source": "Measurement",
      "target": "DateTime",
      "kind": "aggregates"
    },
    {
      "id": "measurement-write",
      "source": "Sensor.getMeasurement",
      "target": "MeasurementRecord",
      "kind": "writes"
    },
    {
      "id": "range-true",
      "source": "range",
      "target": "result",
      "kind": "true"
    },
    {
      "id": "range-false",
      "source": "range",
      "target": "error",
      "kind": "false"
    },
    {
      "id": "measurement-sensor-fk",
      "source": "MeasurementRecord",
      "target": "SensorRecord",
      "kind": "relates-to",
      "sourceFields": [
        "sensorId"
      ],
      "targetFields": [
        "id"
      ],
      "sourceEndpoint": {
        "role": "measurements",
        "multiplicity": "0..*"
      },
      "targetEndpoint": {
        "role": "sensor",
        "multiplicity": "1"
      }
    }
  ],
  "requirements": [
    {
      "id": "valid-range",
      "text": "Return measurements only in the supported range.",
      "nodeIds": [
        "Sensor.getMeasurement"
      ],
      "edgeIds": [
        "range-true"
      ],
      "constraints": [
        "Reject out-of-range readings"
      ],
      "scenarios": [
        "A valid reading returns its value."
      ]
    }
  ]
}
