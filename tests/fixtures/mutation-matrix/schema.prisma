datasource db {
  provider = "sqlite"
}

model Customer {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  name   String?
  orders Order[]
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int
  amount     Float
  customer   Customer @relation(fields: [customerId], references: [id])
  @@map("orders")
}
