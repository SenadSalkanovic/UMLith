datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("order_statuses")
}

model Order {
  id        Int         @id @default(autoincrement())
  orderNum  String      @unique(map: "order_num_unique") @map("order_number")
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now()) @map("created_at")
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  orderId   Int      @map("order_id")
  itemId    Int      @map("item_id")
  quantity  Int      @default(1)
  price     Float
  sku       String   @unique(map: "sku_unique") @map("item_sku")
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id])

  @@id([orderId, itemId], map: "pk_order_items")
  @@unique([orderId, sku], map: "order_sku_unique", name: "order_sku_compound")
  @@index([createdAt, quantity], map: "order_items_created_qty_idx")
  @@map("order_items")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique @map("tag_slug")
}
