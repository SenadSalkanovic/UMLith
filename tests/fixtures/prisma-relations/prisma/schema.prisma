datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  managerId     Int?     @map("manager_id")
  manager       User?    @relation("UserManagement", fields: [managerId], references: [id])
  reports       User[]   @relation("UserManagement")
  profile       Profile?
  authoredPosts Post[]   @relation("AuthoredPosts")
  reviewedPosts Post[]   @relation("ReviewedPosts")

  @@map("users")
}

model Profile {
  id     Int    @id @default(autoincrement())
  bio    String
  userId Int    @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String?
  authorId   Int      @map("author_id")
  author     User     @relation("AuthoredPosts", fields: [authorId], references: [id])
  reviewerId Int?     @map("reviewer_id")
  reviewer   User?    @relation("ReviewedPosts", fields: [reviewerId], references: [id])
  tags       Tag[]

  @@map("posts")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]

  @@map("tags")
}
